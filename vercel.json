{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "my.csenergy.solar"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "customerapp"
        }
      ],
      "destination": "https://my.csenergy.solar/?customerapp=1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "engineer.csenergy.solar"
        }
      ],
      "destination": "/engineer.html"
    }
  ]
}